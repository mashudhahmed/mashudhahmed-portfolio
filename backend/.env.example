# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (Local PostgreSQL or Cloud like Neon/Supabase)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:password@localhost:5432/portfolio_db

# Admin Security Credentials
ADMIN_TOKEN=your_super_secret_admin_token_here

# JWT Authentication Config
JWT_SECRET=super_secret_portfolio_jwt_key_2026_secure!
JWT_EXPIRES_IN=7d

# Allowed CORS Origins (comma-separated frontend URLs)
CORS_ORIGINS=http://localhost:3000,https://mashudhahmed.vercel.app

# Database Schema Auto-Sync (Defaults to true to auto-create missing tables on boot)
DB_SYNCHRONIZE=true

