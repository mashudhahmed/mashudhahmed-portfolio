# Backend API URL (where the NestJS backend is running)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cloudinary (Used for image uploads in admin dashboard)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=ml_default

# Site URL (Defaults to https://mashudhahmed.vercel.app)
NEXT_PUBLIC_SITE_URL=https://mashudhahmed.vercel.app
